
@model SitePet.Models.Adocao

@{
    ViewData["Title"] = "Formulário de Adoção";
}

<div class="container pagina-adocao">

    <div class="cartao-adocao">

        <h1>Formulário de Adoção</h1>

        <p class="texto-adocao">
            Que bom que você quer dar uma nova chance a um pet!
            Preencha seus dados para iniciar sua solicitação de adoção.
        </p>

        <form asp-controller="Adocao"
              asp-action="Termos"
              method="post">

            <input type="hidden" asp-for="PetId" />
            <input type="hidden" asp-for="NomePet" />

            <section class="dados-pet">
                <h2>Pet escolhido</h2>
                <p>
                    <strong>Nome:</strong> @Model.NomePet
                </p>
            </section>

            <section class="dados-adotante">
                <h2>Seus dados</h2>

                <div class="campo-formulario">
                    <label asp-for="NomeCompleto">Nome completo</label>
                    <input asp-for="NomeCompleto" type="text"
                           placeholder="Digite seu nome completo" />
                    <span asp-validation-for="NomeCompleto"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Telefone">Telefone</label>
                    <input asp-for="Telefone" type="tel"
                           placeholder="(00) 00000-0000" />
                    <span asp-validation-for="Telefone"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Email">E-mail</label>
                    <input asp-for="Email" type="email"
                           placeholder="seuemail@exemplo.com" />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Idade">Idade</label>
                    <input asp-for="Idade" type="number"
                           min="18" placeholder="Sua idade" />
                    <span asp-validation-for="Idade"></span>
                </div>
            </section>

            <section class="endereco-adotante">
                <h2>Endereço completo</h2>

                <div class="campo-formulario">
                    <label asp-for="CEP">CEP</label>
                    <input asp-for="CEP" type="text"
                           placeholder="00000-000" />
                    <span asp-validation-for="CEP"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Rua">Rua</label>
                    <input asp-for="Rua" type="text"
                           placeholder="Nome da rua ou avenida" />
                    <span asp-validation-for="Rua"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Numero">Número</label>
                    <input asp-for="Numero" type="text"
                           placeholder="Número da residência" />
                    <span asp-validation-for="Numero"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Complemento">Complemento (opcional)</label>
                    <input asp-for="Complemento" type="text"
                           placeholder="Casa, apartamento..." />
                </div>

                <div class="campo-formulario">
                    <label asp-for="Bairro">Bairro</label>
                    <input asp-for="Bairro" type="text"
                           placeholder="Seu bairro" />
                    <span asp-validation-for="Bairro"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Cidade">Cidade</label>
                    <input asp-for="Cidade" type="text"
                           placeholder="Sua cidade" />
                    <span asp-validation-for="Cidade"></span>
                </div>

                <div class="campo-formulario">
                    <label asp-for="Estado">Estado</label>
                    <select asp-for="Estado">
                        <option value="">Selecione seu estado</option>
                        <option value="AC">Acre</option>
                        <option value="AL">Alagoas</option>
                        <option value="AP">Amapá</option>
                        <option value="AM">Amazonas</option>
                        <option value="BA">Bahia</option>
                        <option value="CE">Ceará</option>
                        <option value="DF">Distrito Federal</option>
                        <option value="ES">Espírito Santo</option>
                        <option value="GO">Goiás</option>
                        <option value="MA">Maranhão</option>
                        <option value="MT">Mato Grosso</option>
                        <option value="MS">Mato Grosso do Sul</option>
                        <option value="MG">Minas Gerais</option>
                        <option value="PA">Pará</option>
                        <option value="PB">Paraíba</option>
                        <option value="PR">Paraná</option>
                        <option value="PE">Pernambuco</option>
                        <option value="PI">Piauí</option>
                        <option value="RJ">Rio de Janeiro</option>
                        <option value="RN">Rio Grande do Norte</option>
                        <option value="RS">Rio Grande do Sul</option>
                        <option value="RO">Rondônia</option>
                        <option value="RR">Roraima</option>
                        <option value="SC">Santa Catarina</option>
                        <option value="SP">São Paulo</option>
                        <option value="SE">Sergipe</option>
                        <option value="TO">Tocantins</option>
                    </select>
                    <span asp-validation-for="Estado"></span>
                </div>
            </section>

            <div class="acoes-formulario">

                <a asp-controller="Home"
                   asp-action="QueroAdotar"
                   class="botao-cancelar">
                    Voltar
                </a>

                <button type="submit" class="botao-enviar">
                    Continuar
                </button>

            </div>

        </form>

    </div>

</div>
