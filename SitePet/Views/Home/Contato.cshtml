@model SitePet.Models.MensagemContato

@{
    ViewData["Title"] = "Contato";
}

<div class="container mt-5 pagina-contato">

    <div class="text-center mb-4">
        <h1>Entre em contato</h1>
        <p>
            Tem alguma dúvida ou deseja saber mais sobre nosso projeto?
            Estamos aqui para ajudar!
        </p>
    </div>

    <div class="cartao-contato">
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="alert alert-success">
                @TempData["MensagemSucesso"]
            </div>
        }

        <h3>Fale conosco</h3>

        <p><strong>Email:</strong> contato@esperancatempatas.com</p>
        <p><strong>Telefone:</strong> (14) 99999-9999</p>
        <p><strong>WhatsApp:</strong> (14) 99999-9999</p>

        <hr />

        <h3>Envie sua mensagem</h3>

        <form asp-controller="Home" asp-action="Contato" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Seu nome" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Seu email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Assunto" class="form-label">Assunto</label>
                <input asp-for="Assunto" class="form-control" placeholder="Assunto da mensagem" />
                <span asp-validation-for="Assunto" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Mensagem" class="form-label">Mensagem</label>
                <textarea asp-for="Mensagem" class="form-control" rows="5" placeholder="Digite sua mensagem"></textarea>
                <span asp-validation-for="Mensagem" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-enviar">
                Enviar mensagem
            </button>

        </form>

    </div>

</div>
