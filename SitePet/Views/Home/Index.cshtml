
@{
    ViewData["Title"] = "Página Inicial";
}

<div class="pagina-inicial text-center p-3">

    <img class="banner-principal"
         src="~/img/golpes1.png"
         alt="Banner principal do Esperança tem Patas" />

    <div class="botao-contato-inicial">
        <a asp-controller="Home"
           asp-action="Contato"
           class="btn btn-contato">
            Entre em contato
        </a>
    </div>

    <div class="banners-informativos">
        <img src="~/img/1.png"
             alt="Informação sobre adoção" />

        <img src="~/img/2.png"
             alt="Informação sobre adoção" />

        <img src="~/img/3.png"
             alt="Informação sobre adoção" />
    </div>

</div>
