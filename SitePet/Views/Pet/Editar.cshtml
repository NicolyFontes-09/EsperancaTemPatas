@model SitePet.Models.Pet

@{
    ViewData["Title"] = "Editar Pet";
}

<div class="pagina-pet">
    <div class="caixa-pet">

        <h1>Editar Pet</h1>

        <form asp-controller="Pet" asp-action="Editar" method="post"
              enctype="multipart/form-data" class="formulario-pet">

            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="campo-pet">
                <label for="Nome">Nome do Pet</label>
                <input type="text" id="Nome" name="Nome"
                       value="@Model.Nome" required />
            </div>

            <div class="campo-pet">
                <label for="Especie">Espécie</label>
                <select id="Especie" name="Especie" required>
                    <option value="">Selecione</option>
                    <option value="Cachorro" selected="@(Model.Especie == "Cachorro")">Cachorro</option>
                    <option value="Gato" selected="@(Model.Especie == "Gato")">Gato</option>
                </select>
            </div>

            <div class="campo-pet">
                <label for="Raca">Raça</label>
                <input type="text" id="Raca" name="Raca"
                       value="@Model.Raca" />
            </div>

            <div class="campo-pet">
                <label for="Sexo">Sexo</label>
                <select id="Sexo" name="Sexo" required>
                    <option value="">Selecione</option>
                    <option value="Macho" selected="@(Model.Sexo == "Macho")">Macho</option>
                    <option value="Fêmea" selected="@(Model.Sexo == "Fêmea")">Fêmea</option>
                </select>
            </div>

            <div class="campo-pet">
                <label for="Idade">Idade (anos)</label>
                <input type="number" id="Idade" name="Idade"
                       min="0" step="1" value="@Model.Idade" required />
            </div>

            <div class="campo-pet">
                <label for="Porte">Porte</label>
                <select id="Porte" name="Porte" required>
                    <option value="">Selecione</option>
                    <option value="Pequeno" selected="@(Model.Porte == "Pequeno")">Pequeno</option>
                    <option value="Médio" selected="@(Model.Porte == "Médio")">Médio</option>
                    <option value="Grande" selected="@(Model.Porte == "Grande")">Grande</option>
                </select>
            </div>

            <div class="campo-pet">
                <label for="Vacinas">Vacinas</label>
                <input type="text" id="Vacinas" name="Vacinas"
                       value="@Model.Vacinas" />
            </div>

            <div class="campo-pet">
                <label for="Castrado">Castrado?</label>
                <select id="Castrado" name="Castrado" required>
                    <option value="">Selecione</option>
                    <option value="true" selected="@(Model.Castrado == true)">Sim</option>
                    <option value="false" selected="@(Model.Castrado == false)">Não</option>
                </select>
            </div>

            <div class="campo-pet">
                <label for="Localizacao">Localização</label>
                <input type="text" id="Localizacao" name="Localizacao"
                       value="@Model.Localizacao" />
            </div>

            <div class="campo-pet">
                <label for="Foto">Alterar imagem do pet</label>
                <input type="file" id="Foto" name="Foto" accept="image/*" />
            </div>

            <div class="campo-pet">
                <label for="Descricao">Descrição do Pet</label>
                <textarea id="Descricao" name="Descricao"
                          rows="4">@Model.Descricao</textarea>
            </div>

            <div class="botoes-pet">

                <button type="submit" class="botao-pet">
                    Salvar Alterações
                </button>

                <a asp-controller="Pet"
                   asp-action="Index"
                   class="botao-cancelar-pet">
                    Cancelar
                </a>

            </div>

        </form>

    </div>
</div>