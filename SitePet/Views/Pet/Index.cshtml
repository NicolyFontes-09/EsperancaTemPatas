
@model List<SitePet.Models.Pet>

@{
    ViewData["Title"] = "Gerenciar Pets";
}

<div class="container mt-4 pagina-gerenciar-pets">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gerenciar Pets</h1>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center mt-5">
            <h4>Nenhum pet cadastrado.</h4>
            <p>Cadastre um animal para começar.</p>

            <a asp-controller="Pet"
               asp-action="Cadastrar"
               class="btn btn-primary">
                Cadastrar primeiro pet
            </a>
        </div>
    }
    else
    {
        <div class="tabela-gerenciar-pets">

            <table class="table table-bordered table-striped align-middle">

                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>Nome</th>
                        <th>Espécie</th>
                        <th>Raça</th>
                        <th>Porte</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var pet in Model)
                    {
                        <tr>
                            <td data-label="Foto">
                                <img src="@Url.Content(pet.Foto)"
                                     alt="Foto de @pet.Nome"
                                     class="foto-gerenciar-pet" />
                            </td>

                            <td data-label="Nome">@pet.Nome</td>

                            <td data-label="Espécie">@pet.Especie</td>

                            <td data-label="Raça">@pet.Raca</td>

                            <td data-label="Porte">@pet.Porte</td>

                            <td data-label="Ações">
                                <div class="acoes-gerenciar-pets">

                                    <a asp-controller="Pet"
                                       asp-action="Editar"
                                       asp-route-id="@pet.Id"
                                       class="btn btn-warning">
                                        Editar
                                    </a>

                                    <a asp-controller="Pet"
                                       asp-action="Excluir"
                                       asp-route-id="@pet.Id"
                                       class="btn btn-danger">
                                        Excluir
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <div class="text-center mt-3">
            <a asp-controller="Pet"
               asp-action="Cadastrar"
               class="btn btn-primary px-4 py-2">
                Cadastrar Pet
            </a>
        </div>
    }

</div>
