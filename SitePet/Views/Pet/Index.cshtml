@model List<SitePet.Models.Pet>

@{
    ViewData["Title"] = "Gerenciar Pets";
}

<div class="container mt-4 pagina-gerenciar-pets">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Gerenciar Pets</h1>

        <a asp-action="Cadastrar" class="btn btn-primary">
            Cadastrar Pet
        </a>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center mt-5">
            <h4>Nenhum pet cadastrado.</h4>
            <p>Cadastre um animal para começar.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped align-middle">

                <thead>
                    <tr>
                        <th>Foto</th>
                        <th>Nome</th>
                        <th>Espécie</th>
                        <th>Raça</th>
                        <th>Porte</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var pet in Model)
                    {
                        <tr>
                            <td>
                                <img src="@Url.Content(pet.Foto)"
                                     alt="@pet.Nome"
                                     style="width:80px;height:80px;object-fit:cover;" />
                            </td>

                            <td>@pet.Nome</td>
                            <td>@pet.Especie</td>
                            <td>@pet.Raca</td>
                            <td>@pet.Porte</td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-action="Detalhes"
                                       asp-route-id="@pet.Id"
                                       class="btn btn-primary btn-sm">
                                        Detalhes
                                    </a>

                                    <a asp-action="Editar"
                                       asp-route-id="@pet.Id"
                                       class="btn btn-warning btn-sm">
                                        Editar
                                    </a>

                                    <a asp-action="Excluir"
                                       asp-route-id="@pet.Id"
                                       class="btn btn-danger btn-sm">
                                        Excluir
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>
