
@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString();
    var actionAtual = ViewContext.RouteData.Values["action"]?.ToString();

    var estaNaAreaAdmin =
        (controllerAtual == "Pet" &&
         new[] { "Index", "Cadastrar", "Editar", "Excluir", "ConfirmarExclusao" }.Contains(actionAtual))
        ||
        (controllerAtual == "Adocao" &&
         new[] { "Pendencia", "Detalhes", "Rejeitar" }.Contains(actionAtual));
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SitePet</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SitePet.styles.css" asp-append-version="true" />
</head>

<body class="bdefundo">

    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom box-shadow mb-3 bcolor">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="@(estaNaAreaAdmin ? "Pet" : "Home")"
                   asp-action="Index">

                    <img class="logo-nav"
                         src="~/img/logo-site.png"
                         alt="Esperança Tem Patas" />
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-between"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav flex-grow-1">

                        @if (estaNaAreaAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link fs-5 fw-bold menu-item"
                                   asp-controller="Pet"
                                   asp-action="Index">
                                    Gerenciar Pets
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link fs-5 fw-bold menu-item"
                                   asp-controller="Adocao"
                                   asp-action="Pendencia">
                                    Solicitações de Adoção
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fs-5 fw-bold menu-item"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Página Inicial
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link fs-5 fw-bold menu-item"
                                   asp-controller="Home"
                                   asp-action="QueroAdotar">
                                    Quero Adotar
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link fs-5 fw-bold menu-item"
                                   asp-controller="Home"
                                   asp-action="QuemSomos">
                                    Quem Somos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link fs-5 fw-bold menu-item"
                                   asp-controller="Adocao"
                                   asp-action="MinhasAdocoes">
                                    Minhas Adoções
                                </a>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container rounded mb-2">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bcolor">
        <div class="container">
            &copy; Esperança Tem Patas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
