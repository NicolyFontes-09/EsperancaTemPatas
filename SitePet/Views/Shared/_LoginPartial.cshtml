@using Microsoft.AspNetCore.Http

<ul class="navbar-nav">

    @if (Context.Session.GetString("Token") != null)
    {
        <li class="nav-item">
            <span class="nav-link fs-5 fw-bold menu-item">
                Olá, @Context.Session.GetString("NomeUsuario")!
            </span>
        </li>

        <li class="nav-item">
            <form asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link fs-5 fw-bold menu-item">
                    Sair
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link fs-5 fw-bold menu-item"
               asp-controller="Auth"
               asp-action="Login">
                Entrar
            </a>
        </li>
    }

</ul>
